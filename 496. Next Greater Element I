class Solution(object):
    def nextGreaterElement(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: List[int]
        """
        # we need to firstly treat with nums2, because nums1 is a subset of nums2
        stack = []
        load_dict = {}

        for num in nums2:
            while stack and stack[-1] < num:
                s_value = stack.pop()
                load_dict[s_value] = num
            stack.append(num)

        return [load_dict.get(x,-1) for x in nums1] #note: if exist x, else -1
