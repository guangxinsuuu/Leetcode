# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def removeNthFromEnd(self, head, n):
        """
        :type head: Optional[ListNode]
        :type n: int
        :rtype: Optional[ListNode]
        """
        dummy_head = ListNode(next = head)
        quick_pointer = dummy_head
        slow_pointer = dummy_head

        i = 0

        while quick_pointer.next:
            if i >= n:
                slow_pointer = slow_pointer.next
            quick_pointer = quick_pointer.next
            i += 1

        slow_pointer.next = slow_pointer.next.next

        return dummy_head.next

Note:
Two pointer is faster than hashmap

fast pointer can firstly move n steps, then both, reduce the define of i, more better
            
