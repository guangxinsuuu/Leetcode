# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def pseudoPalindromicPaths (self, root: Optional[TreeNode]) -> int:
        self.res = 0
        self.path = {}
        self.traverse(root)
        return self.res


    def traverse(self, root):

        if root is None:
            return
        
        self.path[root.val] = self.path.get(root.val,0)+1

        if root.left is None and root.right is None:
            i = 0
            for num in self.path.values():
                
                if num % 2 == 1:
                    i+=1
                if i == 2:
                    break                            # break the for loop, not return
            if i < 2:
                self.res+=1
        
        

        self.traverse(root.left)
        self.traverse(root.right)

        self.path[root.val] = self.path.get(root.val,0)-1

        if self.path[root.val] == 0:
            del self.path[root.val]
        
