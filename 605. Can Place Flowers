class Solution:
    def canPlaceFlowers(self, flowerbed: List[int], n: int) -> bool:
        slow = 0
        quick = 0

        cnt = 0 
        res = 0

        while quick < len(flowerbed):
            

            if flowerbed[quick] == 0:
                quick += 1
                cnt += 1
            else: 
                if cnt:                                      # i forget this one
                    if flowerbed[slow] == 1:
                        res += (cnt+1)//2-1
                    else:
                        res += cnt//2
                    cnt = 0 
                slow = quick
                quick += 1
        if cnt > 0:
            if flowerbed[slow] == 1:
                res += cnt//2
            else:
                res += (cnt+1)//2
        if res >= n:
            return True
        else:
            return False

            
            
        
