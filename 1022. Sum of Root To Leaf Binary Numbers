    def traverse(self, root):
        if root is None:
            return
        
        # 1) 进栈
        self.rot.append(root.val)
        
        # 2) 若是叶子节点，则根据当前 self.rot 计算一次二进制值并累加到 self.res
        if root.left is None and root.right is None:
            cnt = 0
            val = 0
            # 从头到尾累加：最高位在 rot[0]
            for bit in self.rot:
                val = (val << 1) | bit           #########i am still not understand
            self.res += val
        
        # 3) 递归左右
        self.traverse(root.left)
        self.traverse(root.right)
        
        # 4) 回滚，上一步 append 的元素出栈
        self.rot.pop()
        
