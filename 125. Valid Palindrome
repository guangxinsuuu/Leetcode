class Solution(object):
    def isPalindrome(self, s):
        """
        :type s: str
        :rtype: bool
        """
        left, right = 0, len(s)-1

        while left < right:
            
            while not s[left].isalnum() and left < right:                # Note: we need to use while
                left += 1
            while not s[right].isalnum() and left < right:               #Note: we need to consider both alpha and number
                right -= 1
            if s[left].lower() == s[right].lower():                # we can use lower to compare
                left += 1
                right -= 1
            else:
                return False
        return True            
