# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def oddEvenList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        
        # cur = head
        # nxt = head.next
        # dummy_head = ListNode()
        # res = dummy_head
        

        # while nxt:

        #     cur.next = nxt.next
        #     dummy_head.next = nxt
        #     dummy_head = dummy_head.next
        #     cur = cur.next
        #     nxt = cur.next
        # cur.next = res.next
        # return head
        if not head or not head.next:
            return head

        odd = head                # 奇链表尾
        even = head.next          # 偶链表尾
        even_head = even          # 保存偶链表头

        # 同时向后推进 odd 和 even
        while even and even.next:
            odd.next = even.next
            odd = odd.next

            even.next = odd.next
            even = even.next

        # 拼接：奇链表尾接上偶链表头
        odd.next = even_head
        return head

            

        
