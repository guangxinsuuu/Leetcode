class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        result = []
        hs = {}
        
        for idx,num in enumerate(nums):
            if (target-num) in hs:                            #hash, sequence is important  Time O(n) Space O(n)
                return [hs[target-num],idx]
            if num not in hs:
                hs[num] = idx
            
   
        
        
