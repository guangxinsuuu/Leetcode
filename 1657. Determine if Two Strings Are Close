class Solution:
    def closeStrings(self, word1: str, word2: str) -> bool:
        if len(word1) != len(word2) or set(word1) != set(word2):
            return False
        res1 = [0]*26
        res2 = [0]*26

        for word in word1:
            res1[ord(word)-97] += 1
        for word in word2:
            res2[ord(word)-97] += 1
        if sorted(res1) == sorted(res2):                 #sorted time complexity is O(NlogN), but here the length is fixed and only 26 charaters, So O(1)
            return True
        else:
            return False

        
